{
    "name": "karacraft/roleperm",
    "description": "Role and permission management for Laravel with guards, caching, and an optional Livewire dashboard.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "roles",
        "permissions",
        "rbac",
        "authorization"
    ],
    "homepage": "https://github.com/Karacraft/roleperm",
    "support": {
        "issues": "https://github.com/Karacraft/roleperm/issues",
        "source": "https://github.com/Karacraft/roleperm"
    },
    "autoload": {
        "psr-4": {
            "Karacraft\\RolesAndPermissions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karacraft\\RolesAndPermissions\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Karacraft",
            "email": "kcraftpk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "livewire/livewire": "Required to use the optional frontend dashboard (^3.0)."
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karacraft\\RolesAndPermissions\\RolesAndPermissionsServiceProvider",
                "Karacraft\\RolesAndPermissions\\PermissionsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
