{
    "name": "karacraft/roleperm",
    "description": "Simple",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Karacraft\\RolesAndPermissions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karacraft\\RolesAndPermissions\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Karacraft",
            "email": "kcraftpk@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel":{
            "providers": [
                "Karacraft\\RolesAndPermissions\\RolesAndPermissionsServiceProvider",
                "Karacraft\\RolesAndPermissions\\PermissionsServiceProvider"
            ]
        }
    }
}
